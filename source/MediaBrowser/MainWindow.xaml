<Window x:Class="MediaBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MediaBrowser.ViewModels"
        xmlns:models="clr-namespace:MediaBrowser.Models"
        Title="MediaBrowser"
        MinWidth="800" MinHeight="500"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}">

    <Window.Resources>
        <!-- Media thumbnail item template -->
        <DataTemplate x:Key="MediaItemTemplate" DataType="{x:Type models:MediaFile}">
            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="4"
                    Width="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=Window}}"
                    Height="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=Window}}"
                    ToolTip="{Binding Path}"
                    ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <!-- Image thumbnail (for Image and Animated types) -->
                    <Image x:Name="ThumbnailImage"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static models:MediaType.Image}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static models:MediaType.Animated}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>

                    <!-- Video placeholder -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static models:MediaType.Video}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Rectangle Fill="#1A1A2E"/>
                        <TextBlock Text="▶" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}" Opacity="0.8"/>
                    </Grid>

                    <!-- Info overlay at bottom -->
                    <Border VerticalAlignment="Bottom"
                            Background="#CC000000"
                            Padding="4,2">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="#E2E8F0"/>
                            <TextBlock FontSize="9" Foreground="#94A3B8">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} · {1}">
                                        <Binding Path="Extension"/>
                                        <Binding Path="Size" Converter="{StaticResource FileSizeConverter}"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Type badge -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="4" Padding="4,2" CornerRadius="4"
                            Background="{StaticResource PrimaryBrush}" Opacity="0.9">
                        <TextBlock Text="{Binding TypeDisplay}" FontSize="9" FontWeight="SemiBold"
                                   Foreground="White"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- ═══════════════ TOP TOOLBAR ═══════════════ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel>
                <!-- Row 1: Browse + Search + Type Filter + Sort -->
                <WrapPanel Orientation="Horizontal" ItemHeight="32">
                    <!-- Browse button -->
                    <Button x:Name="BrowseButton"
                            Content="📁 Browse"
                            Style="{StaticResource ToolbarButton}"
                            Click="BrowseButton_Click"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"/>

                    <!-- Cancel scan button -->
                    <Button x:Name="CancelButton"
                            Content="✕ Cancel"
                            Style="{StaticResource SecondaryButton}"
                            Click="CancelButton_Click"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"/>

                    <Separator Width="1" Height="24" Background="{StaticResource BorderBrush}" Margin="0,0,8,0"/>

                    <!-- Search box -->
                    <Label Content="🔍" VerticalAlignment="Center" Margin="0,0,2,0" Foreground="{StaticResource SubtextBrush}"/>
                    <TextBox x:Name="SearchBox"
                             Width="180"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Style.Resources>
                                    <VisualBrush x:Key="HintBrush" TileMode="None" Stretch="None" AlignmentX="Left">
                                        <VisualBrush.Visual>
                                            <TextBlock Text="Search by filename…" Foreground="#4A5568" FontFamily="Segoe UI" FontSize="13"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Style.Resources>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Separator Width="1" Height="24" Background="{StaticResource BorderBrush}" Margin="0,0,8,0"/>

                    <!-- File type filter -->
                    <Label Content="Type:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="FilterTypeCombo"
                              Width="100"
                              ItemsSource="{Binding FilterTypes}"
                              SelectedItem="{Binding FilterType}"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"/>

                    <Separator Width="1" Height="24" Background="{StaticResource BorderBrush}" Margin="0,0,8,0"/>

                    <!-- Sort field -->
                    <Label Content="Sort:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="SortFieldCombo"
                              Width="130"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"
                              ItemsSource="{Binding SortFields}"
                              SelectedItem="{Binding SortField}"/>

                    <!-- Sort direction toggle -->
                    <Button x:Name="SortDirButton"
                            Style="{StaticResource SecondaryButton}"
                            Click="SortDirButton_Click"
                            VerticalAlignment="Center"
                            Padding="8,4"
                            Margin="0,0,8,0">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="↑ A→Z"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SortAscending}" Value="False">
                                            <Setter Property="Text" Value="↓ Z→A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </WrapPanel>

                <!-- Row 2: Date range + Size range (collapsible) -->
                <WrapPanel Orientation="Horizontal" Margin="0,6,0,0" ItemHeight="28">
                    <Label Content="Modified from:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <DatePicker x:Name="DateFromPicker"
                                Width="130"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0"
                                SelectedDateChanged="DateFromPicker_SelectedDateChanged"/>

                    <Label Content="to:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <DatePicker x:Name="DateToPicker"
                                Width="130"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0"
                                SelectedDateChanged="DateToPicker_SelectedDateChanged"/>

                    <Separator Width="1" Height="24" Background="{StaticResource BorderBrush}" Margin="0,0,12,0"/>

                    <Label Content="Size ≥" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="SizeMinBox"
                             Width="80"
                             VerticalAlignment="Center"
                             Margin="0,0,4,0"
                             TextChanged="SizeMinBox_TextChanged"/>
                    <Label Content="KB" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <Label Content="≤" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="SizeMaxBox"
                             Width="80"
                             VerticalAlignment="Center"
                             Margin="0,0,4,0"
                             TextChanged="SizeMaxBox_TextChanged"/>
                    <Label Content="KB" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <Button Content="Clear Filters"
                            Style="{StaticResource SecondaryButton}"
                            Click="ClearFilters_Click"
                            VerticalAlignment="Center"
                            Padding="8,4"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ═══════════════ BOTTOM STATUS + ZOOM BAR ═══════════════ -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status text -->
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource SubtextBrush}"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Zoom label -->
                <TextBlock Grid.Column="1"
                           Text="🔍 Zoom:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontSize="12"
                           Foreground="{StaticResource SubtextBrush}"/>

                <!-- Zoom slider -->
                <Slider Grid.Column="2"
                        x:Name="ZoomSlider"
                        Minimum="100"
                        Maximum="800"
                        Value="{Binding ThumbnailSize}"
                        TickFrequency="50"
                        IsSnapToTickEnabled="False"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"/>

                <!-- Zoom value display -->
                <TextBlock Grid.Column="3"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource SubtextBrush}"
                           MinWidth="50">
                    <TextBlock.Text>
                        <Binding Path="ThumbnailSize" StringFormat="{}{0}px"/>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ═══════════════ LOADING OVERLAY ═══════════════ -->
        <Grid DockPanel.Dock="Top" Height="3"
              Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
            <ProgressBar x:Name="ScanProgress"
                         IsIndeterminate="True"
                         Height="3"
                         Background="Transparent"
                         Foreground="{StaticResource AccentBrush}"
                         BorderThickness="0"/>
        </Grid>

        <!-- ═══════════════ MAIN MEDIA GRID ═══════════════ -->
        <Grid>
            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DisplayedFiles.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="📷" FontSize="64" HorizontalAlignment="Center" Opacity="0.3"/>
                <TextBlock Text="No media files to display"
                           FontSize="20" FontWeight="Light"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource SubtextBrush}"
                           Margin="0,8,0,4"/>
                <TextBlock Text="Click 'Browse' to open a directory with images, videos, or GIFs"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource SubtextBrush}"
                           Opacity="0.7"/>
            </StackPanel>

            <!-- Media items -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="{StaticResource BackgroundBrush}"
                          Padding="8">
                <ItemsControl x:Name="MediaItemsControl"
                              ItemsSource="{Binding DisplayedFiles}"
                              ItemTemplate="{StaticResource MediaItemTemplate}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"
                                       x:Name="MediaWrapPanel"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
