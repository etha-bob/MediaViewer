<Window x:Class="MediaBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:MediaBrowser.Models"
        Title="MediaBrowser"
        MinWidth="800" MinHeight="500"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}">

    <Window.Resources>
        <!-- ═══ Media thumbnail item template ═══ -->
        <DataTemplate x:Key="MediaItemTemplate" DataType="{x:Type models:MediaFile}">
            <Border x:Name="CardBorder"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="4"
                    ClipToBounds="True"
                    Cursor="Hand"
                    MouseDown="MediaCard_MouseDown"
                    ToolTip="{Binding Path}">

                <!-- Dynamic width from ThumbnailSize -->
                <Border.Width>
                    <Binding Path="DataContext.ThumbnailSize" RelativeSource="{RelativeSource AncestorType=Window}"/>
                </Border.Width>

                <!-- Height: ThumbnailSize when square, Auto (NaN) when preserving aspect ratio -->
                <Border.Height>
                    <MultiBinding Converter="{StaticResource CardHeightConverter}">
                        <Binding Path="DataContext.ThumbnailSize" RelativeSource="{RelativeSource AncestorType=Window}"/>
                        <Binding Path="DataContext.PreserveAspectRatio" RelativeSource="{RelativeSource AncestorType=Window}"/>
                    </MultiBinding>
                </Border.Height>

                <!-- Hover + selected border highlight -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="Background" Value="{StaticResource SelectedBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <!-- Right-click context menu -->
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open" FontWeight="Bold" Click="MenuOpen_Click"/>
                        <MenuItem Header="Open With…" Click="MenuOpenWith_Click"/>
                        <Separator/>
                        <MenuItem Header="Copy" Click="MenuCopy_Click"/>
                        <MenuItem Header="Cut" Click="MenuCut_Click"/>
                        <Separator/>
                        <MenuItem Header="Delete" Click="MenuDelete_Click"/>
                        <MenuItem Header="Rename…" Click="MenuRename_Click"/>
                        <Separator/>
                        <MenuItem Header="Properties" Click="MenuProperties_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                    <!-- Image thumbnail (Image + Animated types) -->
                    <Image x:Name="ThumbnailImage"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Stretch>
                            <Binding Path="DataContext.PreserveAspectRatio"
                                     RelativeSource="{RelativeSource AncestorType=Window}"
                                     Converter="{StaticResource BoolToStretch}"/>
                        </Image.Stretch>
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static models:MediaType.Image}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static models:MediaType.Animated}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>

                    <!-- Video element (lazy-loaded first frame) -->
                    <MediaElement x:Name="VideoElement"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Stop"
                                  ScrubbingEnabled="True"
                                  MouseEnter="VideoElement_MouseEnter"
                                  MouseLeave="VideoElement_MouseLeave">
                        <MediaElement.Stretch>
                            <Binding Path="DataContext.PreserveAspectRatio"
                                     RelativeSource="{RelativeSource AncestorType=Window}"
                                     Converter="{StaticResource BoolToStretch}"/>
                        </MediaElement.Stretch>
                        <MediaElement.Style>
                            <Style TargetType="MediaElement">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static models:MediaType.Video}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MediaElement.Style>
                    </MediaElement>

                    <!-- Video placeholder (shown before source is loaded) -->
                    <Grid x:Name="VideoPlaceholder">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static models:MediaType.Video}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Rectangle Fill="#1A1A2E"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="▶" FontSize="28" HorizontalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}" Opacity="0.8"/>
                            <TextBlock Text="{Binding Extension}" FontSize="9" HorizontalAlignment="Center"
                                       Foreground="{StaticResource SubtextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Info overlay at bottom -->
                    <Border VerticalAlignment="Bottom"
                            Background="#CC000000"
                            Padding="4,2">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="#E2E8F0"/>
                            <TextBlock FontSize="9" Foreground="#94A3B8">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} · {1}">
                                        <Binding Path="Extension"/>
                                        <Binding Path="Size" Converter="{StaticResource FileSizeConverter}"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Type badge -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="4" Padding="4,2" CornerRadius="4"
                            Background="{StaticResource PrimaryBrush}" Opacity="0.9">
                        <TextBlock Text="{Binding TypeDisplay}" FontSize="9" FontWeight="SemiBold"
                                   Foreground="White"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Metadata row template for right panel -->
        <DataTemplate x:Key="MetaRowTemplate">
            <Grid Margin="0,3,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}"
                           Foreground="{StaticResource SubtextBrush}"
                           FontSize="11" TextWrapping="NoWrap"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="11" TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- ═══════════════ TOP TOOLBAR ═══════════════ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel>
                <!-- Row 1: Panel toggles + Browse + Search + Filters + Sort + Aspect ratio -->
                <WrapPanel Orientation="Horizontal" ItemHeight="32">

                    <!-- Left panel toggle -->
                    <ToggleButton x:Name="LeftPanelToggle"
                                  Content="☰ Dirs"
                                  Style="{StaticResource ToggleButtonStyle}"
                                  IsChecked="{Binding LeftPanelOpen}"
                                  Click="LeftPanelToggle_Click"
                                  Margin="0,0,4,0" VerticalAlignment="Center"/>

                    <!-- Browse button -->
                    <Button x:Name="BrowseButton"
                            Content="📁 Browse"
                            Style="{StaticResource ToolbarButton}"
                            Click="BrowseButton_Click"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"/>

                    <!-- Cancel scan button -->
                    <Button x:Name="CancelButton"
                            Content="✕ Cancel"
                            Style="{StaticResource SecondaryButton}"
                            Click="CancelButton_Click"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"/>

                    <Separator Width="1" Height="24" Background="{StaticResource BorderBrush}" Margin="4,0"/>

                    <!-- Search box -->
                    <TextBox x:Name="SearchBox"
                             Width="180"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"
                             Margin="0,0,4,0"/>

                    <Separator Width="1" Height="24" Background="{StaticResource BorderBrush}" Margin="4,0"/>

                    <!-- File type filter -->
                    <Label Content="Type:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="FilterTypeCombo"
                              Width="100"
                              ItemsSource="{Binding FilterTypes}"
                              SelectedItem="{Binding FilterType}"
                              VerticalAlignment="Center"
                              Margin="0,0,4,0"/>

                    <Separator Width="1" Height="24" Background="{StaticResource BorderBrush}" Margin="4,0"/>

                    <!-- Sort field -->
                    <Label Content="Sort:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="SortFieldCombo"
                              Width="130"
                              VerticalAlignment="Center"
                              Margin="0,0,4,0"
                              ItemsSource="{Binding SortFields}"
                              SelectedItem="{Binding SortField}"/>

                    <!-- Sort direction toggle -->
                    <Button x:Name="SortDirButton"
                            Style="{StaticResource SecondaryButton}"
                            Click="SortDirButton_Click"
                            VerticalAlignment="Center"
                            Padding="8,4"
                            Margin="0,0,8,0">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="↑ A→Z"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SortAscending}" Value="False">
                                            <Setter Property="Text" Value="↓ Z→A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <Separator Width="1" Height="24" Background="{StaticResource BorderBrush}" Margin="0,0,8,0"/>

                    <!-- Aspect ratio toggle -->
                    <ToggleButton x:Name="AspectRatioToggle"
                                  Style="{StaticResource ToggleButtonStyle}"
                                  IsChecked="{Binding PreserveAspectRatio}"
                                  Margin="0,0,4,0" VerticalAlignment="Center"
                                  ToolTip="Preserve original aspect ratio">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="⬜ Square"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreserveAspectRatio}" Value="True">
                                            <Setter Property="Text" Value="🖼 Ratio"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </ToggleButton>

                    <!-- Right panel toggle -->
                    <ToggleButton x:Name="RightPanelToggle"
                                  Content="Details ▶"
                                  Style="{StaticResource ToggleButtonStyle}"
                                  IsChecked="{Binding RightPanelOpen}"
                                  Click="RightPanelToggle_Click"
                                  Margin="0,0,0,0" VerticalAlignment="Center"/>
                </WrapPanel>

                <!-- Row 2: Date range + Size range -->
                <WrapPanel Orientation="Horizontal" Margin="0,6,0,0" ItemHeight="28">
                    <Label Content="Modified:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <DatePicker x:Name="DateFromPicker"
                                Width="130"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0"
                                SelectedDateChanged="DateFromPicker_SelectedDateChanged"/>

                    <Label Content="to" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <DatePicker x:Name="DateToPicker"
                                Width="130"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0"
                                SelectedDateChanged="DateToPicker_SelectedDateChanged"/>

                    <Separator Width="1" Height="24" Background="{StaticResource BorderBrush}" Margin="0,0,12,0"/>

                    <Label Content="Size ≥" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="SizeMinBox"
                             Width="72"
                             VerticalAlignment="Center"
                             Margin="0,0,2,0"
                             TextChanged="SizeMinBox_TextChanged"/>
                    <Label Content="KB  ≤" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="SizeMaxBox"
                             Width="72"
                             VerticalAlignment="Center"
                             Margin="0,0,2,0"
                             TextChanged="SizeMaxBox_TextChanged"/>
                    <Label Content="KB" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <Button Content="Clear Filters"
                            Style="{StaticResource SecondaryButton}"
                            Click="ClearFilters_Click"
                            VerticalAlignment="Center"
                            Padding="8,4"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ═══════════════ BOTTOM STATUS + ZOOM BAR ═══════════════ -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource SubtextBrush}"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Column="1"
                           Text="🔍 Zoom:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontSize="12"
                           Foreground="{StaticResource SubtextBrush}"/>

                <Slider Grid.Column="2"
                        x:Name="ZoomSlider"
                        Minimum="100"
                        Maximum="800"
                        Value="{Binding ThumbnailSize}"
                        TickFrequency="50"
                        IsSnapToTickEnabled="False"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"/>

                <TextBlock Grid.Column="3"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource SubtextBrush}"
                           MinWidth="50"
                           Text="{Binding ThumbnailSize, StringFormat='{}{0}px'}"/>
            </Grid>
        </Border>

        <!-- ═══════════════ SCAN PROGRESS BAR ═══════════════ -->
        <ProgressBar DockPanel.Dock="Top"
                     x:Name="ScanProgress"
                     Height="3"
                     IsIndeterminate="True"
                     Background="Transparent"
                     Foreground="{StaticResource AccentBrush}"
                     BorderThickness="0"
                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"/>

        <!-- ═══════════════ MAIN 3-COLUMN AREA ═══════════════ -->
        <Grid x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPanelCol" Width="220" MinWidth="0"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition x:Name="RightPanelCol" Width="0" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT PANEL: Subdirectory filter ── -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Visibility="{Binding LeftPanelOpen, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <!-- Header -->
                    <Border DockPanel.Dock="Top"
                            Padding="10,8"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock Text="📁 Directories"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{StaticResource TextBrush}"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="All" Style="{StaticResource SecondaryButton}"
                                        Padding="6,2" FontSize="11"
                                        Click="SubDirSelectAll_Click" Margin="0,0,4,0"/>
                                <Button Content="None" Style="{StaticResource SecondaryButton}"
                                        Padding="6,2" FontSize="11"
                                        Click="SubDirSelectNone_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Subdirectory list -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding SubDirectories}"
                                      Margin="6,6,6,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:SubDirectoryNode}">
                                    <CheckBox Content="{Binding Name}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Margin="2,3,2,3"
                                              Padding="4,0,0,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Left splitter -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"/>

            <!-- ── CENTER: Media grid ── -->
            <Grid Grid.Column="2">
                <!-- Empty state overlay -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DisplayedFiles.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="📷" FontSize="64" HorizontalAlignment="Center" Opacity="0.3"/>
                    <TextBlock Text="No media files to display"
                               FontSize="20" FontWeight="Light"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource SubtextBrush}"
                               Margin="0,8,0,4"/>
                    <TextBlock Text="Click 'Browse' to open a directory with images, videos, or GIFs"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource SubtextBrush}"
                               Opacity="0.7"/>
                </StackPanel>

                <!-- Scrollable media grid – lazy loading fires on ScrollChanged -->
                <ScrollViewer x:Name="MainScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="{StaticResource BackgroundBrush}"
                              Padding="8"
                              ScrollChanged="MainScrollViewer_ScrollChanged">
                    <ItemsControl x:Name="MediaItemsControl"
                                  ItemsSource="{Binding DisplayedFiles}"
                                  ItemTemplate="{StaticResource MediaItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Right splitter -->
            <GridSplitter Grid.Column="3"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"/>

            <!-- ── RIGHT PANEL: Metadata inspector ── -->
            <Border Grid.Column="4"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="{Binding RightPanelOpen, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <!-- Header -->
                    <Border DockPanel.Dock="Top"
                            Padding="10,8"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="ℹ Details"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{StaticResource TextBrush}"/>
                    </Border>

                    <!-- No selection message: shown when SelectedFile is null -->
                    <TextBlock DockPanel.Dock="Top"
                               Text="Click a file to see its details."
                               Foreground="{StaticResource SubtextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="10,12,10,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedFile}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Metadata content -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SelectedFile, Converter={StaticResource NotNullToVisibility}}">
                        <StackPanel Margin="10,8,10,10"
                                    DataContext="{Binding SelectedFile}">

                            <!-- Thumbnail preview -->
                            <Border CornerRadius="6" ClipToBounds="True"
                                    Margin="0,0,0,10" MaxHeight="200">
                                <Image x:Name="DetailThumbnail"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:MediaType.Image}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="{x:Static models:MediaType.Animated}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </Border>

                            <!-- Filename header -->
                            <TextBlock Text="{Binding Name}"
                                       FontSize="13" FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,0,0,8"/>

                            <!-- Metadata rows -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <!-- Type -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Type"
                                           Foreground="{StaticResource SubtextBrush}" FontSize="11" Margin="0,3"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TypeDisplay}"
                                           FontSize="11" Margin="0,3"/>

                                <!-- Extension -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Extension"
                                           Foreground="{StaticResource SubtextBrush}" FontSize="11" Margin="0,3"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Extension}"
                                           FontSize="11" Margin="0,3"/>

                                <!-- Size -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Size"
                                           Foreground="{StaticResource SubtextBrush}" FontSize="11" Margin="0,3"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SizeDisplay}"
                                           FontSize="11" Margin="0,3"/>

                                <!-- Dimensions -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Dimensions"
                                           Foreground="{StaticResource SubtextBrush}" FontSize="11" Margin="0,3"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DimensionDisplay}"
                                           FontSize="11" Margin="0,3"/>

                                <!-- Created -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Created"
                                           Foreground="{StaticResource SubtextBrush}" FontSize="11" Margin="0,3"/>
                                <TextBlock Grid.Row="4" Grid.Column="1"
                                           Text="{Binding DateCreated, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                           FontSize="11" Margin="0,3"/>

                                <!-- Modified -->
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Modified"
                                           Foreground="{StaticResource SubtextBrush}" FontSize="11" Margin="0,3"/>
                                <TextBlock Grid.Row="5" Grid.Column="1"
                                           Text="{Binding DateModified, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                           FontSize="11" Margin="0,3"/>

                                <!-- Directory -->
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Folder"
                                           Foreground="{StaticResource SubtextBrush}" FontSize="11" Margin="0,3"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Directory}"
                                           FontSize="11" Margin="0,3" TextWrapping="Wrap"/>

                                <!-- Full path -->
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Path"
                                           Foreground="{StaticResource SubtextBrush}" FontSize="11" Margin="0,3"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Path}"
                                           FontSize="11" Margin="0,3" TextWrapping="Wrap"/>
                            </Grid>

                            <!-- Open button -->
                            <Button Content="▶ Open File"
                                    Style="{StaticResource ToolbarButton}"
                                    Click="DetailOpenButton_Click"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
